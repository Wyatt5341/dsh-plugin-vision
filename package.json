{
  "name": "dsh-plugin-vision",
  "version": "1.0.0",
  "description": "DSH vision plugin: analyze image files through an OpenAI-compatible vision model (adds the analyze_image tool).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.0",
    "@deepseek-ai/dsh-fs": ">=0.2.0-rc.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.0",
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
